pipeline {
  agent any
  options { disableConcurrentBuilds(); timestamps() }
  stages {
    stage('Dependencies') {
      steps {
        sh 'python3 -m venv .venv'
        sh '.venv/bin/python -m pip install -r requirements-dev.txt'
      }
    }
    stage('Contract schema and compatibility') {
      steps {
        sh '.venv/bin/python src/odcs.py'
        sh '.venv/bin/python src/check_contract_changes.py'
      }
    }
    stage('Regression and recovery') {
      steps { sh '.venv/bin/python -m unittest discover -s tests -v' }
    }
    stage('Independent recurring acceptance') {
      steps {
        sh '.venv/bin/python src/ci_acceptance.py --out build/acceptance'
        sh '.venv/bin/python src/export_integrations.py'
      }
    }
  }
  post {
    always {
      archiveArtifacts artifacts: 'build/acceptance/evidence/**/*.json,contracts/odcs/*.json,integrations/**/*', allowEmptyArchive: true
    }
  }
}

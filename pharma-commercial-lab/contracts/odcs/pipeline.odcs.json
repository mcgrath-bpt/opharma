{
  "apiVersion": "v3.1.0",
  "customProperties": [
    {
      "property": "layer",
      "value": "pipeline"
    },
    {
      "property": "dependsOn",
      "value": [
        "pharma.commercial.source",
        "pharma.commercial.canonical"
      ]
    },
    {
      "property": "runtime",
      "value": {
        "engine": "python-sqlite",
        "majorVersionRequiredForBreakingChanges": true,
        "qualityGate": "fail structural or reconciliation errors; record percentage alerts",
        "schemaGate": "src/odcs.py",
        "target": "snowflake-sql-python",
        "timezone": "UTC"
      }
    },
    {
      "property": "scenarioSemantics",
      "value": {
        "S1": {
          "consent": "current at cutoff",
          "deadlineUtc": "07:00",
          "matchAlertAbove": 0.02
        },
        "S2": {
          "deadlineUtc": "06:30",
          "hierarchy": "current at cutoff",
          "unknownProductAlertAbove": 0.01
        },
        "S3": {
          "interval": "half open; latest effective assignment wins; equal-date conflict fails"
        },
        "S4": {
          "delete": "tombstone suppresses all downstream scenarios",
          "lateArrivalCalendarDays": 7,
          "latest": "highest accepted version"
        },
        "S5": {
          "matchAlertAbove": 0.05,
          "schedule": "Monday; daily diagnostic calculations",
          "window": "campaign start inclusive/end exclusive"
        }
      }
    }
  ],
  "dataProduct": "synthetic-pharma-commercial-lab",
